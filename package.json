{
  "name": "@webship-js/ghost-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for testing Ghost sites with webship-js.",
  "main": "tests/step-definitions/ghost.steps.js",
  "files": [
    "tests/step-definitions/*.js",
    "tests/features",
    "tests/fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "test:examples": "node tests/check-examples.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "ghost",
    "webship-js",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/ghost-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/ghost-steps/issues"
  },
  "homepage": "https://github.com/webship/ghost-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.10"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.10"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
